[0.302, "o", "\r\u001b[3d\u001b[K\u001b[4;41H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[5;34H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[41G\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[6;34H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m...\u001b[39;49m\u001b[37m\u001b[40m@\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m*\u001b[7;34H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[6b\u001b[8;34H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[41G\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[9;26H\u001b[9;34H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[41G\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[10;34H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[6b\u001b[6;38H"]
