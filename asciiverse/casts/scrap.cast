[0.252, "o", "\u001b[3;11HYou hit the buggy's power cell, destroying it! The enemy explodes!\u001b[K\u001b[5;61H\u001b[32m\u001b[42m_\u001b[13b\u001b(B\u001b[0;1m\u001b[37m\u001b[42m99%\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[12b\u001b[7;61H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m2\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40mmedium gun\u001b[8;38H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m%\u001b[8;61H\u001b[32m\u001b[42m_\u001b[13b\u001b(B\u001b[0;1m\u001b[37m\u001b[42m79%\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[6b\u001b[30m\u001b[40m______\u001b[10;63H\u001b(B\u001b[0;1m\u001b[36m\u001b[40mtwo-wheel drive\u001b[11;61H\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[13b\u001b(B\u001b[0;1m\u001b[37m\u001b[42m94%\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[11b\u001b[13;63H\u001b(B\u001b[0;1m\u001b[36m\u001b[40mshort-range sensor\u001b[14;61H\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[13b\u001b(B\u001b[0;1m\u001b[37m\u001b[42m96%\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[11b\u001b[16;61H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m5\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40miron plating\u001b[17;61H\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[13b\u001b(B\u001b[0;1m\u001b[37m\u001b[42m97%\u001b(B\u001b[0m\u001b[32m\u001b[42m_\u001b[12b\u001b[19;61H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m6\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40mminigun\u001b[20;61H\u001b(B\u001b[0m\u001b[34m\u001b[44m_\u001b[12b\u001b(B\u001b[0;1m\u001b[37m\u001b[44m100%\u001b(B\u001b[0m\u001b[34m\u001b[44m_\u001b[12b\u001b[6;36H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.352, "o", "\r\u001b[3d\u001b[K\u001b[4;40H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[5;33H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[40G\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[6;33H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m*\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[6b\u001b[7;33H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m...\u001b[39;49m\u001b[37m\u001b[40m@\u001b[32m\u001b[40m...\u001b[8;33H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[40G\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[8;75H\u001b[37m\u001b[42m80\u001b[9;33H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[40G\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[10;34H.\u001b[6b\u001b[7;37H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
